    {
      "name": "8 — Cascade Delete",
      "item": [

        {
          "name": "Step 1 — Create Parent Task",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('cascadeParentId', pm.response.json().id);",
                "console.log('Cascade parent id:', pm.response.json().id);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cascade parent task\",\n  \"description\": \"Will be deleted with its subtasks\",\n  \"priority\": \"low\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/", "host": ["{{baseUrl}}"], "path": ["tasks", ""] }
          }
        },

        {
          "name": "Step 2 — Create Subtask under Parent",
