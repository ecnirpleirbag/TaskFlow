{
  "info": {
    "name": "TaskFlow API",
    "_postman_id": "taskflow-api-collection-v1",
    "description": "Complete test collection for the TaskFlow API — covers CRUD, NL creation, subtasks, breakdown, idempotency, filtering, cascade delete, and all error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "taskId",  "value": "",  "type": "string", "description": "Auto-set by 'Create Task' request" },
    { "key": "subtaskId", "value": "", "type": "string", "description": "Auto-set by 'Create Subtask' request" }
  ],
  "item": [

    {
      "name": "1 — Task CRUD",
      "item": [

        {
          "name": "Create Task (valid)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('Has id', () => pm.expect(json.id).to.be.a('number'));",
                "pm.test('Title correct', () => pm.expect(json.title).to.eql('Buy groceries'));",
                "pm.test('is_subtask is false', () => pm.expect(json.is_subtask).to.be.false);",
                "pm.collectionVariables.set('taskId', json.id);",
                "console.log('Saved taskId:', json.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"priority\": \"high\",\n  \"due_date\": \"2026-12-25\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/", "host": ["{{baseUrl}}"], "path": ["tasks", ""] }
          }
        },

        {
          "name": "List Tasks",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Has results array', () => pm.expect(json.results).to.be.an('array'));",
                "pm.test('Has count', () => pm.expect(json.count).to.be.a('number'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tasks/", "host": ["{{baseUrl}}"], "path": ["tasks", ""] }
          }
        },

        {
          "name": "Retrieve Task",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Id matches', () => pm.expect(json.id).to.eql(parseInt(pm.collectionVariables.get('taskId'))));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}/", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}", ""] }
          }
        },

        {
          "name": "Retrieve Task — 404 Not Found",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                "const json = pm.response.json();",
                "pm.test('Error code is NOT_FOUND', () => pm.expect(json.error.code).to.eql('NOT_FOUND'));",
                "pm.test('Has message string', () => pm.expect(json.error.message).to.be.a('string'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tasks/99999/", "host": ["{{baseUrl}}"], "path": ["tasks", "99999", ""] }
          }
        },

        {
          "name": "Update Task (PUT)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Title updated', () => pm.expect(json.title).to.eql('Buy groceries and snacks'));",
                "pm.test('Completed updated', () => pm.expect(json.completed).to.be.true);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries and snacks\",\n  \"description\": \"Milk, eggs, bread, chips\",\n  \"priority\": \"high\",\n  \"completed\": true,\n  \"due_date\": \"2026-12-25\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}/", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}", ""] }
          }
        },

        {
          "name": "Partial Update Task (PATCH)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Priority updated', () => pm.expect(json.priority).to.eql('low'));",
                "pm.test('Completed reset', () => pm.expect(json.completed).to.be.false);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"low\",\n  \"completed\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}/", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}", ""] }
          }
        },

        {
          "name": "Delete Task",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 204', () => pm.response.to.have.status(204));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}/", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}", ""] }
          }
        },

        {
          "name": "Delete Task — 404 Not Found",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                "pm.test('Error code is NOT_FOUND', () => pm.response.json().error.code === 'NOT_FOUND');"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/tasks/99999/", "host": ["{{baseUrl}}"], "path": ["tasks", "99999", ""] }
          }
        }

      ]
    },

